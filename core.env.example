MCP_MEMORY_STORAGE_BACKEND=hybrid
MCP_MEMORY_SQLITE_PATH=/app/sqlite_db/memory.db
MCP_SSE_HOST=0.0.0.0
CLOUDFLARE_API_TOKEN=<CLOUDFLARE_API_TOKEN>
MCP_API_KEY=<MCP_API_KEY>
